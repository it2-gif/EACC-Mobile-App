rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.role == 'admin';
    }

    function isSuperAdmin() {
      return isAdmin()
        && request.auth.token.isSuperAdmin == true;
    }

    function canViewAllCourses() {
      return isAdmin()
        && request.auth.token.canViewAllCourses == true;
    }

    function canManageAllChatMessages() {
      return isSuperAdmin() || canViewAllCourses();
    }

    function isTechnicalSupport() {
      return isSignedIn()
        && request.auth.token.isTechnicalSupport == true;
    }

    function isSupportedRole() {
      return isSignedIn()
        && request.auth.token.role in ['student', 'teacher'];
    }

    function hasCourseClaim(courseId) {
      return isSignedIn()
        && request.auth.token.courseIds is list
        && courseId in request.auth.token.courseIds;
    }

    function hasCourse(courseId) {
      return isSupportedRole()
        && hasCourseClaim(courseId);
    }

    function isCourseAdmin(courseId) {
      return isAdmin()
        && (isSuperAdmin() || canViewAllCourses() || hasCourseClaim(courseId));
    }

    function canReadCourseAsAdmin(courseId) {
      return isAdmin()
        && (isSuperAdmin() || canViewAllCourses() || hasCourseClaim(courseId));
    }

    function isStudentThread(threadId) {
      return request.auth.token.role == 'student'
        && request.auth.token.lmsUserId == threadId;
    }

    function isKeyPersonStudentThreadId(threadId) {
      return threadId.matches('^keyperson_student_.+$');
    }

    function isKeyPersonStudentThread(threadId) {
      return request.auth.token.role == 'student'
        && threadId == 'keyperson_student_' + request.auth.token.lmsUserId;
    }

    function isAnnouncementThread(threadId) {
      return threadId == 'announcements';
    }

    function isTeacher() {
      return request.auth.token.role == 'teacher';
    }

    function canAccessThread(courseId, threadId) {
      return hasCourse(courseId)
        && (
          isTeacher()
          || isStudentThread(threadId)
          || isKeyPersonStudentThread(threadId)
          || isAnnouncementThread(threadId)
        );
    }

    function canWriteThread(courseId, threadId) {
      return canAccessThread(courseId, threadId)
        && (!isAnnouncementThread(threadId) || isTeacher());
    }

    function hasValidSender() {
      return request.resource.data.sender_role == request.auth.token.role
        && request.resource.data.sender_name == request.auth.token.displayName;
    }

    function sameField(name) {
      return request.resource.data[name] == resource.data[name];
    }

    function isReadReceiptUpdate(threadId) {
      return request.resource.data.thread_id == threadId
        && sameField('last_message')
        && sameField('last_sender_name')
        && sameField('last_sender_role')
        && sameField('last_message_at')
        && (
          (
            request.auth.token.role == 'student'
            && request.resource.data.student_unread_count == 0
            && request.resource.data.student_last_read_at == request.time
            && sameField('teacher_unread_count')
            && sameField('teacher_last_read_at')
          )
          ||
          (
            request.auth.token.role == 'teacher'
            && request.resource.data.teacher_unread_count == 0
            && request.resource.data.teacher_last_read_at == request.time
            && sameField('student_unread_count')
            && sameField('student_last_read_at')
          )
        );
    }

    function isOutgoingThreadUpdate(threadId) {
      return request.resource.data.thread_id == threadId
        && request.resource.data.last_sender_role == request.auth.token.role
        && request.resource.data.last_sender_name == request.auth.token.displayName
        && (
          isTeacher()
          || request.resource.data.student_name == request.auth.token.displayName
        );
    }

    function isAdminThreadUpdate(threadId) {
      return request.resource.data.thread_id == threadId
        && request.resource.data.last_sender_role == 'admin'
        && request.resource.data.last_sender_name == request.auth.token.displayName;
    }

    function isAnnouncementPinThreadUpdate(threadId) {
      return isAnnouncementThread(threadId)
        && request.auth.token.role in ['teacher', 'admin']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'thread_id',
          'title',
          'is_announcement',
          'pinned',
          'updated_at'
        ])
        && request.resource.data.thread_id == threadId
        && request.resource.data.is_announcement == true
        && request.resource.data.pinned is bool
        && request.resource.data.updated_at == request.time;
    }

    function isAnnouncementPinThreadCreate(threadId) {
      return isAnnouncementThread(threadId)
        && request.auth.token.role in ['teacher', 'admin']
        && request.resource.data.keys().hasOnly([
          'thread_id',
          'title',
          'is_announcement',
          'pinned',
          'updated_at'
        ])
        && request.resource.data.thread_id == threadId
        && request.resource.data.is_announcement == true
        && request.resource.data.pinned is bool
        && request.resource.data.updated_at == request.time;
    }

    function isAnnouncementReadUpdate(threadId) {
      let previousReads = resource.data.get('announcement_reads', {});
      let nextReads = request.resource.data.announcement_reads;
      let readerId = request.auth.uid;
      let receipt = nextReads[readerId];
      return isAnnouncementThread(threadId)
        && request.auth.token.role == 'student'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'thread_id',
          'is_announcement',
          'announcement_reads',
          'updated_at'
        ])
        && request.resource.data.thread_id == threadId
        && request.resource.data.is_announcement == true
        && nextReads is map
        && nextReads.diff(previousReads).affectedKeys().hasOnly([readerId])
        && receipt is map
        && receipt.keys().hasOnly(['role', 'display_name', 'read_at'])
        && receipt.role == request.auth.token.role
        && receipt.display_name == request.auth.token.displayName
        && receipt.read_at == request.time
        && request.resource.data.updated_at == request.time;
    }

    function isTypingUpdate(threadId) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'thread_id',
          'typing_active',
          'typing_role',
          'typing_name',
          'typing_at'
        ])
        && request.resource.data.thread_id == threadId
        && request.resource.data.typing_active is bool
        && request.resource.data.typing_role == request.auth.token.role
        && request.resource.data.typing_name == request.auth.token.displayName
        && request.resource.data.typing_at == request.time;
    }

    function isMessageOwner() {
      return resource.data.sender_role == request.auth.token.role
        && resource.data.sender_name == request.auth.token.displayName;
    }

    function isOwnSupportThread(threadId) {
      return isSignedIn()
        && threadId == 'support_' + request.auth.token.role + '_' + request.auth.token.lmsUserId;
    }

    function canAccessSupportThread(threadId) {
      return isTechnicalSupport() || isOwnSupportThread(threadId);
    }

    function isSupportThreadMessageWrite(threadId) {
      return canAccessSupportThread(threadId)
        && request.resource.data.thread_id == threadId
        && request.resource.data.last_message is string
        && request.resource.data.last_message.size() > 0
        && request.resource.data.last_sender_name == request.auth.token.displayName
        && request.resource.data.last_message_at == request.time
        && request.resource.data.updated_at == request.time
        && (
          (
            isTechnicalSupport()
            && request.resource.data.last_sender_role == 'support'
            && request.resource.data.support_unread_count == 0
          )
          ||
          (
            !isTechnicalSupport()
            && request.resource.data.last_sender_role == request.auth.token.role
            && request.resource.data.user_unread_count == 0
          )
        );
    }

    function isSupportThreadReadUpdate(threadId) {
      return canAccessSupportThread(threadId)
        && request.resource.data.thread_id == threadId
        && request.resource.data.updated_at == request.time
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'thread_id',
          'support_unread_count',
          'support_last_read_at',
          'user_unread_count',
          'user_last_read_at',
          'updated_at'
        ])
        && (
          (
            isTechnicalSupport()
            && request.resource.data.support_unread_count == 0
            && request.resource.data.support_last_read_at == request.time
          )
          ||
          (
            !isTechnicalSupport()
            && request.resource.data.user_unread_count == 0
            && request.resource.data.user_last_read_at == request.time
          )
        );
    }

    function hasValidSupportSender() {
      return request.resource.data.sender_name == request.auth.token.displayName
        && (
          (
            isTechnicalSupport()
            && request.resource.data.sender_role == 'support'
          )
          ||
          (
            !isTechnicalSupport()
            && request.resource.data.sender_role == request.auth.token.role
          )
        );
    }

    function isSupportTextMessage() {
      return request.resource.data.type == 'text'
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0;
    }

    function isSupportImageMessage(threadId) {
      return request.resource.data.type == 'image'
        && request.resource.data.text == ''
        && request.resource.data.media_url is string
        && request.resource.data.media_url.size() > 0
        && request.resource.data.file_name is string
        && request.resource.data.file_name.size() > 0
        && request.resource.data.file_size_bytes is int
        && request.resource.data.file_size_bytes > 0
        && request.resource.data.file_size_bytes <= 5 * 1024 * 1024
        && request.resource.data.file_type is string
        && request.resource.data.storage_path is string
        && request.resource.data.storage_path.matches(
          '^support_uploads/threads/' + threadId + '/.+'
        );
    }

    function isTextMessageEdit() {
      return resource.data.type == 'text'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'text',
          'edited_at'
        ])
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.edited_at == request.time;
    }

    function isSoftMessageDelete() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deleted_at',
          'deleted_by_role',
          'deleted_by_name'
        ])
        && request.resource.data.deleted_at == request.time
        && request.resource.data.deleted_by_role == request.auth.token.role
        && request.resource.data.deleted_by_name == request.auth.token.displayName;
    }

    function isMessageReactionUpdate() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'reactions'
        ])
        && request.resource.data.reactions is map;
    }

    function isMessagePinUpdate() {
      return request.auth.token.role in ['teacher', 'admin']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'pinned',
          'pinned_at',
          'pinned_by_role',
          'pinned_by_name'
        ])
        && request.resource.data.pinned is bool
        && (
          request.resource.data.pinned == false
          || (
            request.resource.data.pinned_at == request.time
            && request.resource.data.pinned_by_role == request.auth.token.role
            && request.resource.data.pinned_by_name == request.auth.token.displayName
          )
        );
    }

    function isAdminTeacherReadUpdate(threadId) {
      return threadId == 'admin_teacher'
        && request.resource.data.thread_id == threadId
        && sameField('last_message')
        && sameField('last_sender_name')
        && sameField('last_sender_role')
        && sameField('last_message_at')
        && (
          (
            request.auth.token.role == 'admin'
            && request.resource.data.admin_unread_count == 0
            && request.resource.data.admin_last_read_at == request.time
            && sameField('teacher_unread_count')
            && sameField('teacher_last_read_at')
          )
          ||
          (
            request.auth.token.role == 'teacher'
            && request.resource.data.teacher_unread_count == 0
            && request.resource.data.teacher_last_read_at == request.time
            && sameField('admin_unread_count')
            && sameField('admin_last_read_at')
          )
        );
    }

    function isKeyPersonStudentReadUpdate(threadId) {
      return isKeyPersonStudentThreadId(threadId)
        && request.resource.data.thread_id == threadId
        && sameField('last_message')
        && sameField('last_sender_name')
        && sameField('last_sender_role')
        && sameField('last_message_at')
        && (
          (
            request.auth.token.role == 'admin'
            && request.resource.data.admin_unread_count == 0
            && request.resource.data.admin_last_read_at == request.time
            && sameField('student_unread_count')
            && sameField('student_last_read_at')
          )
          ||
          (
            request.auth.token.role == 'student'
            && request.resource.data.student_unread_count == 0
            && request.resource.data.student_last_read_at == request.time
            && sameField('admin_unread_count')
            && sameField('admin_last_read_at')
          )
        );
    }

    match /courses/{courseId} {
      allow read: if canReadCourseAsAdmin(courseId) || hasCourse(courseId);
      allow write: if false;

      match /threads/{threadId} {
        allow read: if canReadCourseAsAdmin(courseId) || canAccessThread(courseId, threadId);
        allow create: if isCourseAdmin(courseId)
            ? isAdminThreadUpdate(threadId)
            : canAccessThread(courseId, threadId)
              && (
                (canWriteThread(courseId, threadId) && isOutgoingThreadUpdate(threadId))
                || isAnnouncementPinThreadCreate(threadId)
              );
        allow update: if isCourseAdmin(courseId)
            ? (
                isAdminThreadUpdate(threadId)
                || isAdminTeacherReadUpdate(threadId)
                || isKeyPersonStudentReadUpdate(threadId)
                || isAnnouncementPinThreadUpdate(threadId)
                || isAnnouncementReadUpdate(threadId)
                || isTypingUpdate(threadId)
              )
            : canAccessThread(courseId, threadId)
              && (
                (canWriteThread(courseId, threadId) && isOutgoingThreadUpdate(threadId))
                || isReadReceiptUpdate(threadId)
                || isAdminTeacherReadUpdate(threadId)
                || isKeyPersonStudentReadUpdate(threadId)
                || isAnnouncementReadUpdate(threadId)
                || isAnnouncementPinThreadUpdate(threadId)
                || isTypingUpdate(threadId)
              );
        allow delete: if false;

        match /messages/{messageId} {
          allow read: if canReadCourseAsAdmin(courseId) || canAccessThread(courseId, threadId);
          allow create: if isCourseAdmin(courseId)
              ? hasValidSender()
                && request.resource.data.type in ['text', 'image', 'video', 'voice', 'document']
                && request.resource.data.created_at == request.time
              : canWriteThread(courseId, threadId)
                && hasValidSender()
                && request.resource.data.type in ['text', 'image', 'video', 'voice', 'document']
                && request.resource.data.created_at == request.time;
          allow update: if isCourseAdmin(courseId)
              ? (
                (
                  (canManageAllChatMessages() || isMessageOwner())
                  && (isTextMessageEdit() || isSoftMessageDelete())
                )
                || isMessageReactionUpdate()
                || isMessagePinUpdate()
              )
              : canAccessThread(courseId, threadId)
                && (
                  (
                    isMessageOwner()
                    && (isTextMessageEdit() || isSoftMessageDelete())
                  )
                  || isMessageReactionUpdate()
                  || isMessagePinUpdate()
                );
          allow delete: if false;
        }
      }
    }

    match /support_threads/{threadId} {
      allow read: if canAccessSupportThread(threadId);
      allow create: if isSupportThreadMessageWrite(threadId);
      allow update: if isSupportThreadMessageWrite(threadId)
        || isSupportThreadReadUpdate(threadId);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if canAccessSupportThread(threadId);
        allow create: if canAccessSupportThread(threadId)
          && hasValidSupportSender()
          && (isSupportTextMessage() || isSupportImageMessage(threadId))
          && request.resource.data.created_at == request.time
          && request.resource.data.keys().hasOnly([
            'type',
            'text',
            'media_url',
            'file_name',
            'file_size_bytes',
            'file_type',
            'storage_path',
            'sender_name',
            'sender_role',
            'created_at'
          ]);
        allow update, delete: if false;
      }
    }

    match /{path=**}/messages/{messageId} {
      allow read: if isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /{path=**}/threads/{threadId} {
      allow read: if canViewAllCourses();
      allow create, update, delete: if false;
    }

    match /audit_logs/{logId} {
      allow read: if isSuperAdmin();
      allow create: if isSignedIn()
        && request.resource.data.actor_role == request.auth.token.role
        && request.resource.data.actor_name == request.auth.token.displayName
        && request.resource.data.action is string
        && request.resource.data.resource_type is string
        && request.resource.data.resource_id is string
        && request.resource.data.metadata is map
        && request.resource.data.created_at == request.time;
      allow update, delete: if false;
    }

    match /app_config/{configId} {
      allow read: if isSignedIn();
      allow create, update, delete: if false;
    }
  }
}

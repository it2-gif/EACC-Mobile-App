NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eacc_chat?schema=public
ALLOWED_ORIGINS=http://localhost:58071,http://localhost:8088
LMS_BASE_URL=https://lms.eacc-egy.com
LMS_REQUEST_TIMEOUT_MS=10000
# Temporary mapping while the LMS admin login does not expose numeric key-person IDs.
# Example: testapp:91,anotheradmin:43
LMS_ADMIN_ID_OVERRIDES=
# Optional candidate course IDs for LMS key-person admins. Each course is still
# verified against edit_course.php before it appears in the app.
# Example: 91:2297|2290;43:2203
LMS_KEY_PERSON_COURSE_IDS=

# Backend-only LMS admin credential for on-demand single-course refresh.
# Use a restricted service/admin LMS account when possible. Never expose this
# to the Flutter app.
LMS_SYNC_ADMIN_USERNAME=
LMS_SYNC_ADMIN_PASSWORD=

# Firebase service-account credentials used only by the backend.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

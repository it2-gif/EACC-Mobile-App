NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/eacc_chat?schema=public
ALLOWED_ORIGINS=http://localhost:58071,http://localhost:8088
LMS_BASE_URL=https://lms.eacc-egy.com
LMS_REQUEST_TIMEOUT_MS=10000
# Temporary mapping while the LMS admin login does not expose numeric key-person IDs.
# Example: testapp:91,anotheradmin:43
LMS_ADMIN_ID_OVERRIDES=

# Firebase service-account credentials used only by the backend.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

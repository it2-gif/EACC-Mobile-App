rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && request.auth.token.role == 'admin';
    }

    function isSuperAdmin() {
      return isAdmin()
        && request.auth.token.isSuperAdmin == true;
    }

    function canViewAllCourses() {
      return isAdmin()
        && request.auth.token.canViewAllCourses == true;
    }

    function isTechnicalSupport() {
      return request.auth != null
        && request.auth.token.isTechnicalSupport == true;
    }

    function isSupportedRole() {
      return request.auth != null
        && request.auth.token.role in ['student', 'teacher'];
    }

    function hasCourseClaim(courseId) {
      return request.auth != null
        && request.auth.token.courseIds is list
        && courseId in request.auth.token.courseIds;
    }

    function hasCourse(courseId) {
      return isSupportedRole()
        && hasCourseClaim(courseId);
    }

    function isCourseAdmin(courseId) {
      return isAdmin()
        && (isSuperAdmin() || canViewAllCourses() || hasCourseClaim(courseId));
    }

    function canAccessThread(courseId, threadId) {
      return hasCourse(courseId)
        && (
          (
            request.auth.token.role == 'teacher'
            && !threadId.matches('^keyperson_student_.+$')
          )
          || threadId == 'announcements'
          || (
            request.auth.token.role == 'student'
            && request.auth.token.lmsUserId == threadId
          )
          || (
            request.auth.token.role == 'student'
            && threadId == 'keyperson_student_' + request.auth.token.lmsUserId
          )
        );
    }

    function isValidUpload() {
      return request.resource.size > 0
        && (
          (
            request.resource.contentType.matches('image/.*')
            && request.resource.size <= 5 * 1024 * 1024
          )
          || (
            request.resource.contentType.matches('audio/.*')
            && request.resource.size <= 10 * 1024 * 1024
          )
          || (
            request.resource.contentType.matches('video/.*')
            && request.resource.size <= 50 * 1024 * 1024
          )
          || (
            (
              request.resource.contentType == 'application/pdf'
              || request.resource.contentType == 'application/msword'
              || request.resource.contentType.matches('application/vnd\\..*')
              || request.resource.contentType.matches('text/.*')
              || request.resource.contentType == 'application/octet-stream'
            )
            && request.resource.size <= 25 * 1024 * 1024
          )
        );
    }

    function isOwnSupportThread(threadId) {
      return request.auth != null
        && threadId == 'support_' + request.auth.token.role + '_' + request.auth.token.lmsUserId;
    }

    function canAccessSupportThread(threadId) {
      return isTechnicalSupport() || isOwnSupportThread(threadId);
    }

    function isValidSupportImageUpload() {
      return request.resource.size > 0
        && request.resource.contentType.matches('image/.*')
        && request.resource.size <= 5 * 1024 * 1024;
    }

    match /chat_uploads/courses/{courseId}/threads/{threadId}/{fileName} {
      allow read: if isCourseAdmin(courseId) || canAccessThread(courseId, threadId);
      allow create: if isCourseAdmin(courseId)
          ? isValidUpload()
          : canAccessThread(courseId, threadId) && isValidUpload();
      allow update, delete: if false;
    }

    match /support_uploads/threads/{threadId}/{fileName} {
      allow read: if canAccessSupportThread(threadId);
      allow create: if canAccessSupportThread(threadId)
        && isValidSupportImageUpload();
      allow update, delete: if false;
    }
  }
}
